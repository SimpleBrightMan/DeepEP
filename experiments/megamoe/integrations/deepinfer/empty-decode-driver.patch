+def empty_decode_allowed(seqs, scheduled):
+    # Keep known cache/finish work on the original path. SchedulerOutputs
+    # owns ignored requests and is passed intact to the existing post-process.
+    return (not seqs and scheduled.is_empty() and scheduled.num_batched_tokens == 0
+            and not scheduled.finished_seqs
+            and not any(x.size for x in (scheduled.clone_states, scheduled.clone_blocks, scheduled.zero_states)))
+
+
+def choose_empty_decode(engine, execute, *, torch, dist, group, vote, eplb, state_type, sampler_type):
+    worker = engine.driver_worker
+
+    def run(seqs, scheduled, trace_item):
+        if scheduled.prompt_run:
+            return execute(seqs, scheduled)
+        vote.fill_(0 if empty_decode_allowed(seqs, scheduled) else 1)
+        dist.all_reduce(vote, op=dist.ReduceOp.MAX, group=group)
+        if vote.item():
+            return execute(seqs, scheduled)
+        trace_item['empty_decode_elided'] = True
+        # Preserve previous ZOS output, current EPLB cadence, and the deferred
+        # placeholder state. The real model would only write dummy KV rows.
+        previous = worker.flush_inflight_reqs()
+        sampler = sampler_type(post_funcs=[])
+        # The regular sampler runs EPLB inside inference_mode.
+        with torch.inference_mode():
+            eplb.step(False)
+        def finish_eplb():
+            sampler.moe_load_balance_ratio = eplb.take_moe_load_balance_ratio()
+        sampler.post_funcs.append(finish_eplb)
+        worker.engine_callbacks.pre_sampler_sync_fn(scheduled)
+        worker.maybe_gc_collect()
+        sample_end = torch.cuda.Event(enable_timing=True)
+        sample_end.record()
+        worker.prev_step_state = state_type(
+            seq_metadata_list=[worker.model_runner._placeholder_seq_metadata(False)],
+            scheduler_outputs=scheduled, sampler_output=sampler, is_prompt=False,
+            is_placeholder=True, sample_end_evt=sample_end,
+        )
+        engine.deferred_release.collect_request_outputs(previous)
+        return previous
+
+    return run
+
 
