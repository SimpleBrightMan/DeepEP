  "optimizations": [
    {
      "id": "O1",
      "title": "小 BS 扩大同类 wave 提交预算",
      "branch": "codex/megamoe-ep8-fp4-vf-1012",
      "commit": "16f69d4",
      "experiment": "e01-wave2；随 e20 分支保留",
      "reason": "小 BS 专家碎片多，短批次频繁切换，连续计算窗口不足。",
      "method": "BS<=256 的 mGroupsPerWave 乘 2；不改变专家顺序、资源释放规则和大 BS 的 GMM2 一 wave 滞后。该修改先于跨阶段 handoff。",
      "code": "experiments/megamoe/csrc/forward.cpp:MakeTiling",
      "benefit": "e01 相比 main24：BS32/96/256 分别减少 50.404/54.275/60.515 us；BS4096 基本不变。",
      "caveat": "一次筛选。本报告以所列 e20 分支作为 wave2 的代码载体；不能把 e20 全部收益都归给 FP4。",
      "source": "ep8-parity-round3-1012/reflection-first-two.txt"
    },
    {
      "id": "O2",
      "title": "FP4 解包向量指令简化",
      "branch": "codex/megamoe-ep8-fp4-vf-1012",
      "commit": "16f69d4",
      "experiment": "e20",
      "reason": "长条连续不代表 MMAD 连续；AIV0 的解包吞吐可能限制 Cube 供数，尤其小 M 权重复用少。",
      "method": "以交替字节移位 [4,0] 构造 FP8 位模式，用更少位操作替代 mask/select；保留 packed 格式、NZ 排布、scale 和原 flag。",
      "code": "experiments/megamoe/csrc/kernels/mega_moe/catlass_gmm/block_prologue_a8w4.hpp",
      "benefit": "对 e01：BS32/96/256 减少 55.785/51.289/45.509 us；BS1024 减少 11.203 us；BS4096 无明显收益。",
      "caveat": "全部 256 种 byte 的双 lane 位级检查和五 shape NPU 精度通过；数字为一次筛选。",
      "source": "ep8-parity-round3-1012/reflection-first-two.txt"
    },
    {
      "id": "O3",
      "title": "单 M 块流式权重的缓存策略",
      "branch": "codex/megamoe-ep8-cache-1012",
      "commit": "161ce90",
      "experiment": "e13；与 FP4 合成 e22/855d5a5",
      "reason": "一个专家只有一个 M 块时，权重缺少跨 M 复用，大量流式权重会竞争 L2 容量。",
      "method": "只在单 M 块条件下给 FP4 权重采用绕过缓存的读策略；有跨 M 复用时保留原策略。不改变数学计算。",
      "code": "experiments/megamoe/csrc/kernels/mega_moe/catlass_gmm/mega_moe_grouped_matmul.hpp:weight.SetL2CacheHint",
      "benefit": "e13 对 e01：BS32/96 减少 38.021/36.949 us。组合分支 codex/megamoe-ep8-cache-vf-1012 的 e22：683.840/725.343/795.121/1229.912/4253.305 us。",
      "caveat": "收益支持缓存策略有效，不等于已测出 cache miss 原因；缓存与转换收益不能简单相加。",
      "source": "ep8-parity-extra-1012/reflection.txt"
    },
    {
      "id": "O4",
      "title": "整块 B 转换 + 输入输出 UB 独立轮转",
      "branch": "codex/megamoe-ep8-ub-decoupled-1012",
      "commit": "d09ea96",
      "experiment": "e30；前置 e27/ece0eb3",
      "reason": "原输入槽与输出槽绑定，输出仍在 MTE3 传输时，即使输入已被 V 消费也无法及时复用。",
      "method": "一次准备完整 64 KiB FP8 B 块；3 个 packed 输入槽各 32 KiB、2 个 FP8 输出槽各 64 KiB，总计 224 KiB。输入由 V 读完释放，输出由 MTE3 读完释放，各自维护槽号和事件。",
      "code": "experiments/megamoe/csrc/kernels/mega_moe/catlass_gmm/block_prologue_a8w4.hpp",
      "benefit": "对实用父版本 e22：BS32/96/256 减少 39.683/35.790/28.717 us；BS1024 反增 13.377 us。",
      "caveat": "单独整块转换 e27 严重变慢；e30 对 e27 的约 128 us 回收不是相对旧基线的净收益。需要后续组合抵消中等 BS 回退。",
      "source": "ep8-parity-round8-1012/reflection-final.txt"
    },
    {
      "id": "O5",
      "title": "GMM1/GMM2 之间交接流水所有权",
      "branch": "codex/megamoe-ep8-ub-handoff-1012",
      "commit": "100fa05",
      "experiment": "e31；独立原型 e25/3609594",
      "reason": "同型物理流水每次 End/Begin 都排空、归还 credit、重置游标并重新启动，短 K 更容易暴露固定成本。",
      "method": "AIC/AIV0 在相同 L1/L0/UB 布局之间 HandoffTo，延续 A/B/scale/L0/UB 游标和唯一所有权。SwiGLU 仍等待真实 FIX full；GMM2 仍 DrainOutput 后才发布 Combine 就绪；最终统一 End。",
      "code": "experiments/megamoe/csrc/kernels/mega_moe/mega_moe_wave_a8w4.hpp:RunGmm2/Process；catlass_gmm/mega_moe_grouped_matmul.hpp",
      "benefit": "e31 对 e30：BS32/96/256/1024/4096 减少 8.557/12.226/13.183/4.161/65.943 us。",
      "caveat": "不能删除消费者完成边界；只交接同型资源，不把尚未完成的 FIX 当作完成。独立原型分支 codex/megamoe-ep8-phase-handoff-1012。",
      "source": "ep8-parity-round9-1012"
    },
    {
      "id": "O6",
      "title": "小 M 下供数深度与 MMAD 分块协同",
      "branch": "codex/megamoe-ep8-paired-supply-1012",
      "commit": "7cff1bc",
      "experiment": "e34",
      "reason": "只增加 B 槽或只改 split-N 没有足够收益；生产粒度、A 复用和 credit 深度必须匹配。",
      "method": "采用 A3/B4/SF2 的 L1 配置；M<=128 时 B 的 K512 供数与 N128 分半匹配，L0 K256，并让两个 N 半块复用 A。大 M 保留原 K256/K128 路径。",
      "code": "experiments/megamoe/csrc/kernels/mega_moe/catlass_gmm/a8w4_k_plan.hpp；block_mmad_a8w4.hpp",
      "benefit": "e34 对 e31 三轮均值：BS32/96/256/1024 减少 11.208/16.970/23.578/13.489 us；BS4096 增加 1.949 us。",
      "caveat": "单轮候选对父版本多轮均值，是筛选证据而非严格成组消融。不同 M 路径的容量与 flag 必须同时满足。",
      "source": "ep8-parity-round13-1012"
    },
    {
      "id": "O7",
      "title": "加权 Unpermute 向量融合并剥离首项",
      "branch": "codex/megamoe-ep8-unpermute-peel-1012",
      "commit": "721cfb5",
      "experiment": "e39；前置 e37/762b36f",
      "reason": "最终 top-k 加权归约的搬运及向量发射也占端到端；但朴素融合会让编译后的循环反而更差。",
      "method": "二维搬运收集 BF16 top-k 项，按原顺序 FP32 乘加，最后转 BF16；首个乘积单独初始化累加器，后续循环只做累加。",
      "code": "experiments/megamoe/csrc/kernels/mega_moe/stage/mega_moe_unpermute_fused.hpp；mega_moe_unpermute.hpp",
      "benefit": "e39 对有用父版本 e34：BS256/1024/4096 减少 5.515/6.861/19.449 us，小 BS 基本不变。",
      "caveat": "e37 朴素 VF 在 BS4096 回退到 4473.190 us；修复该回退不能当作相对旧基线的 300 us 收益。",
      "source": "ep8-parity-round20-1012"
    },
    {
      "id": "O8",
      "title": "gate/up 配对拓展到中大 BS",
